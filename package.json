{
  "name": "katka-salamonova",
  "private": true,
  "type": "module",
  "description": "Web Kateřiny Šalamonové a administrace newsletteru na Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply katka-salamonova --local",
    "db:migrate:remote": "wrangler d1 migrations apply katka-salamonova --remote",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
